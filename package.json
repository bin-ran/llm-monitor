{
  "name": "llm-monitor",
  "version": "0.0.2",
  "description": "多平台大模型 API 余额监控桌面应用",
  "author": "binran",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=20.0.0 || >=22.0.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "electron:dev": "vite --mode electron",
    "electron:build": "vue-tsc --build && vite build --mode electron && electron-builder",
    "electron:preview": "electron-builder --dir",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@alicloud/bssopenapi20171214": "^4.1.1",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@unocss/reset": "^66.13.0",
    "@vueuse/core": "^15.1.0",
    "canvas-confetti": "^1.9.4",
    "js-cookie": "^3.0.8",
    "pinia": "^4.1.0",
    "tencentcloud-sdk-nodejs-billing": "^4.1.315",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.30",
    "@tsconfig/node-lts": "^26.0.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "~10.12.1",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.1.0",
    "prettier": "^3.10.1",
    "typescript": "6.0.3",
    "unocss": "^66.13.0",
    "unplugin-vue-router": "^0.19.2",
    "vite": "^8.3.8",
    "vite-plugin-electron": "^1.2.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
